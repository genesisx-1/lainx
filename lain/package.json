{
  "name": "lain",
  "version": "0.1.0",
  "description": "Desktop Browser Shell with Terminal and Local AI",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "bin": {
    "lainx": "./cli/lainx.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "icons": "node scripts/generate-icon.js",
    "build:mac": "npm run build && npm run icons && electron-builder --mac",
    "build:win": "npm run build && npm run icons && electron-builder --win",
    "build:linux": "npm run build && npm run icons && electron-builder --linux",
    "build:all": "npm run build && npm run icons && electron-builder -mwl",
    "postinstall": "node -e \"const fs=require('fs'); const path=require('path'); const bases=['darwin-arm64','darwin-x64']; for(const b of bases){const p=path.join(process.cwd(),'node_modules','node-pty','prebuilds',b,'spawn-helper'); if(fs.existsSync(p)) { try { fs.chmodSync(p,0o755); } catch(e){} }}\"",
    "start": "electron ."
  },
  "keywords": ["electron", "browser", "terminal", "ai", "ollama"],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.lain.browser",
    "productName": "LAIN",
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/after-sign.js",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.1.0",
    "better-sqlite3": "^11.7.0",
    "electron-store": "^8.1.0",
    "node-pty": "^1.0.0",
    "playwright-core": "^1.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.32",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
